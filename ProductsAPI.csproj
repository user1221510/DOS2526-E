<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Impede a geração automática de AssemblyInfo para evitar duplicados -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Correção Crítica: Ignora a pasta de testes para não haver conflito de compilação -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ProductsAPI.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base de Dados Real (SQL Server) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Documentação Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>